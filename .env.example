# Copy to .env (gitignored). Used by docker-compose.yml / docker-compose.ghcr.yml.
# No secrets are needed by ib_exporter itself.
IB_NODE_NAME_MAP=/etc/ib/node-name-map
# Grafana admin password (demo stack default: admin).
GRAFANA_ADMIN_PASSWORD=admin
# Image tag for docker-compose.ghcr.yml.
IB_TAG=latest
# REAL hardware only (see docs/deployment/docker.md): numeric group owning /dev/infiniband/umad*.
#   ls -ln /dev/infiniband/umad*   -> 4th column
UMAD_GID=0
