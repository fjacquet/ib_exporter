{
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 1,
  "title": "InfiniBand - HCA node",
  "uid": "ib-hca-node",
  "tags": [
    "ib",
    "infiniband"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "fabric",
        "label": "Fabric",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(ib_up, fabric)",
          "refId": "vars"
        },
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "node",
        "label": "Node",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(ib_port_xmit_data_bytes_total{node_type=\"hca\"}, node_name)",
          "refId": "vars"
        },
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Throughput",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(ib_port_xmit_data_bytes_total{fabric=~\"$fabric\", node_name=~\"$node\", node_type=\"hca\"}[$__rate_interval])",
          "refId": "A",
          "legendFormat": "{{node_name}} p{{port}} xmit"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(ib_port_rcv_data_bytes_total{fabric=~\"$fabric\", node_name=~\"$node\", node_type=\"hca\"}[$__rate_interval])",
          "refId": "B",
          "legendFormat": "{{node_name}} p{{port}} rcv"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Packets per second",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(ib_port_xmit_packets_total{fabric=~\"$fabric\", node_name=~\"$node\", node_type=\"hca\"}[$__rate_interval])",
          "refId": "A",
          "legendFormat": "{{node_name}} p{{port}} xmit"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(ib_port_rcv_packets_total{fabric=~\"$fabric\", node_name=~\"$node\", node_type=\"hca\"}[$__rate_interval])",
          "refId": "B",
          "legendFormat": "{{node_name}} p{{port}} rcv"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "pps"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Errors/s (symbol, receive, discards)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(ib_port_symbol_error_total{fabric=~\"$fabric\", node_name=~\"$node\", node_type=\"hca\"}[$__rate_interval])",
          "refId": "A",
          "legendFormat": "{{node_name}} p{{port}} symbol"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(ib_port_rcv_errors_total{fabric=~\"$fabric\", node_name=~\"$node\", node_type=\"hca\"}[$__rate_interval])",
          "refId": "B",
          "legendFormat": "{{node_name}} p{{port}} rcv err"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(ib_port_xmit_discards_total{fabric=~\"$fabric\", node_name=~\"$node\", node_type=\"hca\"}[$__rate_interval])",
          "refId": "C",
          "legendFormat": "{{node_name}} p{{port}} discards"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Link rate",
      "description": "Negotiated rate, only present for Active ports.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "ib_port_rate_bytes_per_second{fabric=~\"$fabric\", node_name=~\"$node\", node_type=\"hca\"}",
          "refId": "A",
          "legendFormat": "{{node_name}} p{{port}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "type": "table",
      "title": "Port state and width",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "ib_port_state{fabric=~\"$fabric\", node_name=~\"$node\", node_type=\"hca\"}",
          "refId": "A",
          "legendFormat": "__auto",
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "ib_port_link_width_active{fabric=~\"$fabric\", node_name=~\"$node\", node_type=\"hca\"}",
          "refId": "B",
          "legendFormat": "__auto",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Local HCA throughput (sysfs)",
      "description": "Only when sources.localHCA is enabled (not in the demo).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(ib_hca_xmit_data_bytes_total{fabric=~\"$fabric\"}[$__rate_interval])",
          "refId": "A",
          "legendFormat": "{{device}} p{{port}} xmit"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(ib_hca_rcv_data_bytes_total{fabric=~\"$fabric\"}[$__rate_interval])",
          "refId": "B",
          "legendFormat": "{{device}} p{{port}} rcv"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Local HCA hardware counters/s",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(ib_hca_hw_counter_total{fabric=~\"$fabric\"}[$__rate_interval])",
          "refId": "A",
          "legendFormat": "{{device}} p{{port}} {{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Local HCA state (4 = Active)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "ib_hca_state{fabric=~\"$fabric\"}",
          "refId": "A",
          "legendFormat": "__auto"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 4
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    }
  ],
  "links": []
}
