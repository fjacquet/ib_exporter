          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(ib_port_rcv_fecn_total{fabric=~\"$fabric\"}[$__rate_interval])",
          "refId": "A",
          "legendFormat": "{{node_name}} p{{port}} {{lane}}"
